[user]
  name = Gus Wynn

# Personal vs. work email
[includeIf "gitdir:repos/"]
  path = .gitconfig-personal
[includeIf "gitdir:photography/"]
  path = .gitconfig-personal
[includeIf "gitdir:work/"]
  path = .gitconfig-work
  
# Basic setup
[init]
  defaultBranch = main
[core]
  excludesFile = ~/repos/dotfiles/.gitignore
	commentchar = ";"
[submodule]
  recurse = true

# Aliases
[alias]
  # status and viewing
  st = status
  br = branch -vv
  d = diff 
  s = show
  da = diff --cached
  staged = diff --staged

  # checkout
  c = checkout
  co = checkout
  up = switch

  # Basic quick log
  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --date=relative --abbrev-commit --branches=* -n25

  # lg with everything, and tree versions to inspect the graph
  lgall = log --color --graph --pretty=format:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --date=relative --abbrev-commit --branches=* --remotes=*
  tree = treeall --decorate-refs-exclude='refs/remotes/*/*'
  treeall = lgall --simplify-by-decoration --decorate-refs-exclude='refs/pullreqs/*' --decorate-refs-exclude='refs/tags/*'

  # Some nice shorthands
  quickamend = commit -a --amend --no-edit
  pwf = push --force-with-lease

  # Nice shows
  showreal = show -- . ":(exclude)*Test*" ":(exclude)*Stub*"
  showrealstat = show --stat -- . ":(exclude)*Test*" ":(exclude)*Stub*"

  publish = "!git push -u origin $(git branch --show-current)"
  refresh = "!git up main && git pull && git push origin main"
  branch-diff = "!git diff $(git merge-base --fork-point main)"

  # Assisted-By Attribution
  aa = "!f() { git commit --amend --no-edit --trailer=\"Assisted-By:\"$1\"\"; }; f"

  # Worktrees
  nw = "!f() { git worktree add ../\"$1\"-\"$2\" -b ann-\"$1\"/\"$2\"; }; f"
  nwb = "!f() { git worktree add ../wt-\"$1\" -b \"$1\"; }; f"
  wtenv = "!f() { mkdir .elasticbeanstalk; cp ../\"$1\"/.elasticbeanstalk/config.yml .elasticbeanstalk/config.yml; cp ../\"$1\"/.devel.env .devel.env; cp ../\"$1\"/.envrc .envrc; direnv allow; }; f"

# log decoration colors
[color "decorate"]
	branch = bold yellow
  remoteBranch = yellow magenta
  HEAD = bold black green

# merge and pull details
[merge]
  conflictstyle = diff3
[pull]
  ff = only
[rerere]
  enabled = true
[diff]
  noprefix = true
